#!/bin/bash

# --- Global Binaries and Paths ---
JQ=/usr/bin/jq
FFMPEG="/usr/lib/jellyfin-ffmpeg/ffmpeg" 
FFPROBE="/usr/lib/jellyfin-ffmpeg/ffprobe"
MEDIAINFO="/usr/bin/mediainfo"
DEVICE="/dev/dri/renderD128"
LOG_DIR="/media/rips/logs"
ALLOWED_EXT="mp4,mkv"

export LIBVA_MESSAGING_LEVEL=1

# --- Global Log Definition ---
SHORT_DATE=$(date "+%m-%d-%y")
CURRENT_LOG="$LOG_DIR/logfile-${SHORT_DATE}-PID${$}"

TOTAL_SAVED_BYTES=0
TOTAL_FILES_PROCESSED=0
TOTAL_ORIGINAL_SIZE=0

# ************************************************
function cleanup_on_exit {
    if [[ -n "$TEMP_IN_DIR" && -f "$TEMP_IN_DIR" ]]; then
        echo "[WARN] Script interrupted. Removing incomplete file: $TEMP_IN_DIR"
        rm -f "$TEMP_IN_DIR"
    fi
    exit 1
}
trap cleanup_on_exit SIGINT SIGTERM

if [[ $# -eq 0 ]]; then
    echo "Usage: $0 [-debug] [-noplex] [-sonarr] <input_dir> [output_dir]"
    exit 1
fi

# Parse command line arguments
DEBUG=0; NOPLEX=0; SONARR=0
for arg in "$@"; do
    if [[ "$arg" == "-debug" ]]; then DEBUG=1; fi
    if [[ "$arg" == "-noplex" ]]; then NOPLEX=1; fi
    if [[ "$arg" == "-sonarr" ]]; then SONARR=1; fi
done

# Set directory parameters
TV_INPUT_DIR=""; TV_OUTPUT_DIR=""; arg_count=0
for arg in "$@"; do
    if [[ "$arg" != "-debug" && "$arg" != "-noplex" && "$arg" != "-sonarr" ]]; then
        ((arg_count++))
        if [[ $arg_count -eq 1 ]]; then TV_INPUT_DIR="$arg"; elif [[ $arg_count -eq 2 ]]; then TV_OUTPUT_DIR="$arg"; fi
    fi
done
TV_OUTPUT_DIR=${TV_OUTPUT_DIR:-$TV_INPUT_DIR}

# Load parameter.ini
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARAM_FILE="$SCRIPT_DIR/parameter.ini"
if [[ ! -f "$PARAM_FILE" ]]; then echo "ERROR: parameter.ini not found"; exit 1; fi
source "$PARAM_FILE"

# --- Verification of Parameter.ini ---
REQUIRED_VARS=("SONARR_API_KEY" "SONARR_IP" "SONARR_BASE_PATH" "LOG_RETENTION_DAYS")
for var in "${REQUIRED_VARS[@]}"; do
    if [[ -z "${!var}" ]]; then
        write_log ERROR "Critical variable '$var' is missing or empty in parameter.ini."
    fi
done


# ************************************************
function write_log {
    local short_time=$(date "+%H:%M")
    if [[ -z "$ROTATION_DONE" ]]; then
        local days=${LOG_RETENTION_DAYS:-7}
        find "$LOG_DIR" -name "logfile-*" -type f -mtime +"$days" -delete 2>/dev/null
        ROTATION_DONE=1
    fi
    touch "${CURRENT_LOG}"
    case $1 in
        WARN | INFO | ERROR )
            echo "[$1] (${SHORT_DATE}, ${short_time}) [PID:$$]: $2" >> "${CURRENT_LOG}"
            [[ -t 1 ]] && echo "[$1] $2"
            if [ "$1" = "ERROR" ]; then exit 1; fi ;;
    esac
}

function check_helper_bin {
    if [ ! -x "$JQ" ] || [ ! -x "$MEDIAINFO" ] || [ ! -x "$FFPROBE" ] || [ ! -x "$FFMPEG" ]; then write_log ERROR "Bins missing"; fi
    if [ ! -w "$TV_INPUT_DIR" ] || [ ! -w "$TV_OUTPUT_DIR" ]; then write_log ERROR "Perms issue"; fi
}

function transcode {
    local gq=28; local bf=7; local space_svg=0.2
    INPUT="$1"; BASENAME=$(basename "$INPUT")
    INPUT_DIR=$(dirname "$INPUT")
    OUTPUT_MIRROR_DIR="$2"

    # Temp file is created in the input directory (where the original file is)
    TEMP_IN_DIR="$INPUT_DIR/.${BASENAME%.*}.av1.tmp"
    rm -f "$TEMP_IN_DIR"*

    METADATA=$($FFPROBE -v error -show_entries stream=codec_name,codec_type,nb_frames,r_frame_rate,pix_fmt,channels -show_entries format=duration -of json "$INPUT")
    V_CODEC=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .codec_name' | head -n1)
    SRC_FPS=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .r_frame_rate' | head -n1)
    A_CODEC=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .codec_name' | head -n1)
    A_CHANNELS=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .channels' | head -n1)

    SUBTITLE_OPTS=("-map" "0:s?" "-c:s" "copy")
    VIDEO_OPTS=("-vf" "vpp_qsv=format=p010,fps=fps=$SRC_FPS" "-c:v" "av1_qsv" "-preset" "7" "-global_quality:v" "$gq" "-extbrc" "1" "-b_strategy" "1" "-bf" "$bf" "-low_power" "0")

    A_CODEC_LOWER=$(echo "$A_CODEC" | tr '[:upper:]' '[:lower:]')
    if [[ "$A_CODEC_LOWER" == *"aac"* ]]; then AUDIO_OPTS=("-c:a" "copy"); else
        case $A_CHANNELS in 2) A_BIT="128k"; MAPPING="" ;; 6) A_BIT="256k"; MAPPING="-mapping_family 1" ;; *) A_BIT="128k"; MAPPING="" ;; esac
        AUDIO_OPTS=("-af" "aresample=async=1" "-c:a" "libopus" "-b:a" "$A_BIT" "-vbr" "on" $MAPPING)
    fi

    write_log INFO "=========================================="
    write_log INFO "Processing: $BASENAME"
    write_log INFO "=========================================="
    write_log INFO "Video: $V_CODEC | FPS: $SRC_FPS | Audio: $A_CODEC ($A_CHANNELS ch)"
    write_log INFO "Executing FFmpeg command..."
    FFMPEG_CMD=("$FFMPEG" "-hide_banner" "-loglevel" "error" "-y" "-hwaccel" "qsv" "-qsv_device" "$DEVICE" "-hwaccel_output_format" "qsv")
    "${FFMPEG_CMD[@]}" -i "$INPUT" -map 0:v:0 -map 0:a? "${SUBTITLE_OPTS[@]}" -map_metadata -1 -map_metadata:s:v -1 -map_metadata:s:a -1 "${VIDEO_OPTS[@]}" "${AUDIO_OPTS[@]}" -f matroska "$TEMP_IN_DIR" >> "${CURRENT_LOG}" 2>&1

    if [ $? -eq 0 ] && [[ -f "$TEMP_IN_DIR" ]]; then
        OLD_SIZE=$(stat -c%s "$INPUT"); NEW_SIZE=$(stat -c%s "$TEMP_IN_DIR")
        SAVINGS=$(echo "scale=2; 100 - ($NEW_SIZE * 100 / $OLD_SIZE)" | bc -l)
        OLD_SIZE_MB=$(echo "scale=2; $OLD_SIZE / 1048576" | bc -l)
        NEW_SIZE_MB=$(echo "scale=2; $NEW_SIZE / 1048576" | bc -l)

        if [[ $(echo "$NEW_SIZE < ($OLD_SIZE * (1-$space_svg))" | bc -l) -eq 1 ]]; then
            write_log INFO "Safety checks passed. Savings: ${SAVINGS}% (${OLD_SIZE_MB}MB -> ${NEW_SIZE_MB}MB). Replacing original."
            TOTAL_SAVED_BYTES=$((TOTAL_SAVED_BYTES + (OLD_SIZE - NEW_SIZE)))
            TOTAL_ORIGINAL_SIZE=$((TOTAL_ORIGINAL_SIZE + OLD_SIZE))
            ((TOTAL_FILES_PROCESSED++))
            # Rename converted file to -OPT in the input directory first
            mv "$TEMP_IN_DIR" "$INPUT_DIR/${BASENAME%.*}-OPT.mkv" && rm "$INPUT"
            # If output differs from input, move the -OPT file to output directory
            if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
                mv "$INPUT_DIR/${BASENAME%.*}-OPT.mkv" "$OUTPUT_MIRROR_DIR/${BASENAME%.*}-OPT.mkv"
            fi
        else
            write_log INFO "Conversion complete. Savings: ${SAVINGS}% (${OLD_SIZE_MB}MB -> ${NEW_SIZE_MB}MB). Keeping original with -OPT flag."
            rm -f "$TEMP_IN_DIR"
            ((TOTAL_FILES_PROCESSED++))
            # Rename original to -OPT in the input directory first
            mv "$INPUT" "$INPUT_DIR/${BASENAME%.*}-OPT.${ext}"
            # If output differs from input, move the -OPT file to output directory
            if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
                mv "$INPUT_DIR/${BASENAME%.*}-OPT.${ext}" "$OUTPUT_MIRROR_DIR/${BASENAME%.*}-OPT.${ext}"
            fi
        fi
    fi
}

# Recursion with Folder Structure Preservation
# Recursion with Structure Preservation (The Fix)
process_directory() {
    local input_path="$1"
    local output_path="$2"

    # Create the output directory if it doesn't exist
    if [ ! -d "$output_path" ]; then mkdir -p "$output_path"; fi
    
    for item in "$input_path"/*; do
        if [ ! -e "$item" ]; then continue; fi

        if [ -d "$item" ]; then 
            # ALWAYS PRESERVE STRUCTURE: 
            # Mirror the folder name into the destination
            process_directory "$item" "$output_path/$(basename "$item")"
        elif [ -f "$item" ]; then
            filename=$(basename "$item")
            ext="${filename##*.}"
            
            # --- THE HARVESTER LOGIC ---
            # Move -OPT files to output directory if input and output differ
            if [[ "$filename" == *"-OPT"* ]]; then
                if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
                    write_log INFO "Harvesting -OPT file: $filename"
                    mv "$item" "$output_path/$filename"
                fi
                continue
            fi
            
            # Only process allowed extensions
            if [[ ! ",$ALLOWED_EXT," =~ ",$ext," ]]; then continue; fi
            
            # Run the transcode and output to the mirrored folder
            transcode "$item" "$output_path"
        fi
    done
}

# --- MAIN ---
check_helper_bin
write_log INFO "Start. Input: $TV_INPUT_DIR | Output: $TV_OUTPUT_DIR"

# Pre-processing cleanup: Remove stale temp files and empty directory trees
write_log INFO "Cleaning stale .tmp files and empty directories..."
find "$TV_INPUT_DIR" -name ".*.av1.tmp" -type f -delete 2>/dev/null
find "$TV_INPUT_DIR" -mindepth 1 -type d -empty -delete 2>/dev/null

if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
    find "$TV_OUTPUT_DIR" -mindepth 1 -type d -empty -delete 2>/dev/null
fi

process_directory "$TV_INPUT_DIR" "$TV_OUTPUT_DIR"

# --- POST-PROCESSING ---

# Trigger Sonarr scan if -sonarr flag is set
if [[ $SONARR -eq 1 ]]; then
    write_log INFO "Waiting 5 seconds for filesystem to settle..."
    sleep 5
    
    write_log INFO "Triggering Sonarr to scan: $SONARR_BASE_PATH"
    
    SCAN_RESPONSE=$(curl -s -w "\nHTTP_STATUS:%{http_code}" -X POST \
        -H "X-Api-Key: $SONARR_API_KEY" \
        -H "Content-Type: application/json" \
        -d "{
            \"name\": \"DownloadedEpisodesScan\",
            \"path\": \"$SONARR_BASE_PATH\"
        }" \
        "http://${SONARR_IP}:8989/api/v3/command")

    echo "[SONARR SCAN] $SCAN_RESPONSE" >> "${CURRENT_LOG}"
    write_log INFO "Sonarr scan completed"
fi

# Plex update - runs independently unless -noplex flag is set
if [[ $NOPLEX -eq 0 && -x "$SCRIPT_DIR/Plex-update" ]]; then
    write_log INFO "Triggering Plex library update"
    "$SCRIPT_DIR/Plex-update"
fi

# Cleanup
if [ "$TOTAL_FILES_PROCESSED" -gt 0 ]; then
    if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
        write_log INFO "Cleaning up empty source directories"
        find "$TV_INPUT_DIR" -mindepth 1 -type d -empty -delete
    fi
fi

# --- SUMMARY ---
if [ "$TOTAL_FILES_PROCESSED" -gt 0 ]; then
    TOTAL_SAVED_GB=$(echo "scale=2; $TOTAL_SAVED_BYTES / 1073741824" | bc -l)
    write_log INFO "******************************************"
    write_log INFO "Files Processed: $TOTAL_FILES_PROCESSED"
    write_log INFO "Storage Saved: ${TOTAL_SAVED_GB} GB"
    write_log INFO "******************************************"
fi