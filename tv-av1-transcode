#!/bin/bash

JQ=/usr/bin/jq
FFMPEG="/usr/lib/jellyfin-ffmpeg/ffmpeg" 
FFPROBE="/usr/lib/jellyfin-ffmpeg/ffprobe"
MEDIAINFO="/usr/bin/mediainfo"
DEVICE="/dev/dri/renderD128"
LOG_DIR="/media/rips/logs"
ALLOWED_EXT="mp4,mkv"

# ************************************************
# Function to clean up on exit/interrupt (Trap)
# ************************************************
function cleanup_on_exit {
    if [[ -n "$TEMP_IN_DIR" && -f "$TEMP_IN_DIR" ]]; then
        # Use a simple echo here as write_log might be interrupted
        echo "[WARN] Script interrupted. Removing incomplete file: $TEMP_IN_DIR"
        rm -f "$TEMP_IN_DIR"
    fi
    exit 1
}

# Register Trap for manual interrupts (Ctrl+C) and system termination
trap cleanup_on_exit SIGINT SIGTERM

# Check if no arguments provided
if [[ $# -eq 0 ]]; then
    echo "Usage: $0 [-debug] [-noplex] [-sonarr] <input_dir> [output_dir]"
    exit 1
fi

# Parse command line arguments
DEBUG=0; NOPLEX=0; SONARR=0
for arg in "$@"; do
    if [[ "$arg" == "-debug" ]]; then DEBUG=1; fi
    if [[ "$arg" == "-noplex" ]]; then NOPLEX=1; fi
    if [[ "$arg" == "-sonarr" ]]; then SONARR=1; fi
done

# Set directory parameters
TV_INPUT_DIR=""; TV_OUTPUT_DIR=""; arg_count=0
for arg in "$@"; do
    if [[ "$arg" != "-debug" && "$arg" != "-noplex" && "$arg" != "-sonarr" ]]; then
        ((arg_count++))
        if [[ $arg_count -eq 1 ]]; then TV_INPUT_DIR="$arg"; elif [[ $arg_count -eq 2 ]]; then TV_OUTPUT_DIR="$arg"; fi
    fi
done
TV_OUTPUT_DIR=${TV_OUTPUT_DIR:-$TV_INPUT_DIR}

if [[ $DEBUG -eq 0 ]]; then FFMPEG_REDIRECT="> /dev/null 2>&1"; else FFMPEG_REDIRECT=">> $LOG_DIR/logfile-$(date +%m-%d-%y) 2>&1"; fi

# Load and validate parameter.ini
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARAM_FILE="$SCRIPT_DIR/parameter.ini"
if [[ ! -f "$PARAM_FILE" ]]; then echo "ERROR: parameter.ini not found"; exit 1; fi
source "$PARAM_FILE"

# ************************************************
function write_log {
    local short_date=$(date "+%m-%d-%y"); local short_time=$(date "+%H:%M"); local log_file="$LOG_DIR/logfile-$short_date"
    touch "$log_file"
    case $1 in
        WARN | INFO | ERROR )
            echo "[$1] ($short_date, $short_time): $2" >> "$log_file"
            if [ "$1" = "ERROR" ]; then exit 1; fi ;;
    esac
}

# ************************************************
function check_helper_bin {
    if [ ! -x "$JQ" ] || [ ! -x "$MEDIAINFO" ] || [ ! -x "$FFPROBE" ] || [ ! -x "$FFMPEG" ]; then write_log ERROR "Bins missing"; fi
    if [ ! -w "$TV_INPUT_DIR" ] || [ ! -w "$TV_OUTPUT_DIR" ]; then write_log ERROR "Perms issue"; fi
}

# ************************************************
function transcode {
    local gq=28; local look_depth=60; local bf=7; local space_svg=0.2
    
    INPUT="$1"; BASENAME=$(basename "$INPUT"); EXT="${BASENAME##*.}"
    IN_DIR=$(dirname "$INPUT")
    
    write_log INFO "=========================================="
    write_log INFO "Processing: $BASENAME"
    write_log INFO "=========================================="

    # Write temp file to INPUT directory (hidden) to keep it away from Sonarr
    TEMP_IN_DIR="$IN_DIR/.${BASENAME%.*}.av1.tmp"
    rm -f "$IN_DIR/.${BASENAME%.*}.av1.tmp"*

    V_CODEC=$($FFPROBE -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$INPUT")
    A_CODEC=$($FFPROBE -v error -select_streams a:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$INPUT" | head -n1)
    A_CHANNELS=$($FFPROBE -v error -select_streams a:0 -show_entries stream=channels -of default=noprint_wrappers=1:nokey=1 "$INPUT" | head -n1)
    S_CODEC=$($FFPROBE -v error -select_streams s:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$INPUT" | head -n1)
    ORIG_DURATION=$($FFPROBE -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$INPUT")
    ORIG_FRAMES=$($FFPROBE -v error -select_streams v:0 -show_entries stream=nb_frames -of default=noprint_wrappers=1:nokey=1 "$INPUT")

    # Subtitle Strategy
    if [[ -z "$S_CODEC" ]]; then
        write_log INFO "No subtitles found."
        SUBTITLE_OPTS="-map 0:s?"
    elif [[ "$S_CODEC" =~ ^(subrip|ass|ssa|dvb_subtitle|dvb_teletext)$ ]]; then
        write_log INFO "Subtitle codec is $S_CODEC. Copying subtitles as-is."
        SUBTITLE_OPTS="-map 0:s? -c:s copy"
    else
        write_log INFO "Subtitle codec is $S_CODEC. Converting to ASS format."
        SUBTITLE_OPTS="-map 0:s? -c:s ass"
    fi

    # Video Strategy
    if [[ "$V_CODEC" == "av1" ]]; then
        write_log INFO "Video is already AV1. Setting Video to Passthrough."
        VIDEO_OPTS="-c:v copy"
    else
        write_log INFO "Video is $V_CODEC. Initializing Intel QSV AV1 10-bit Encode (Strict 50fps)."
        VF_CHAIN="vpp_qsv,fps=fps=50,format=p010"
        VIDEO_OPTS="-vf $VF_CHAIN -c:v av1_qsv -preset 7 -global_quality:v $gq -look_ahead_depth $look_depth -extbrc 1 -b_strategy 1 -bf $bf -low_power 0 -pix_fmt p010le -fps_mode cfr -max_interleave_delta 0 -reserve_index_space 100k"
    fi

    # Audio Strategy
    if [[ "$A_CODEC" == "aac" ]]; then
        write_log INFO "Audio is AAC. Setting Audio to Passthrough."
        AUDIO_OPTS="-c:a copy"
    else
        case $A_CHANNELS in 2) A_BIT="128000" ;; 6) A_BIT="256000" ;; 8) A_BIT="320000" ;; *) A_BIT="128000" ;; esac
        write_log INFO "Audio is $A_CODEC ($A_CHANNELS ch). Transcoding to Opus."
        AUDIO_OPTS="-c:a libopus -b:a $A_BIT -mapping_family 1"
    fi

    # Execution
    write_log INFO "Executing FFmpeg command..."
    FFMPEG_EXIT_CODE=0
    if [[ "$V_CODEC" == "av1" ]]; then
        eval "$FFMPEG -i \"$INPUT\" -map 0:v:0 -map 0:a? $SUBTITLE_OPTS -map_metadata 0 $VIDEO_OPTS $AUDIO_OPTS -f matroska \"$TEMP_IN_DIR\" $FFMPEG_REDIRECT" || FFMPEG_EXIT_CODE=$?
    else
        eval "$FFMPEG -hwaccel qsv -qsv_device \"$DEVICE\" -hwaccel_output_format qsv -i \"$INPUT\" -map 0:v:0 -map 0:a? $SUBTITLE_OPTS -map_metadata 0 $VIDEO_OPTS $AUDIO_OPTS -f matroska \"$TEMP_IN_DIR\" $FFMPEG_REDIRECT" || FFMPEG_EXIT_CODE=$?
    fi

    if [ $FFMPEG_EXIT_CODE -ne 0 ]; then
        write_log ERROR "FFmpeg crashed for $BASENAME. Code: $FFMPEG_EXIT_CODE"
        rm -f "$TEMP_IN_DIR"
        return
    fi

    # Safety Checks & Savings Logic
    if [[ -f "$TEMP_IN_DIR" ]]; then
        NEW_FRAMES=$($FFPROBE -v error -select_streams v:0 -show_entries stream=nb_frames -of default=noprint_wrappers=1:nokey=1 "$TEMP_IN_DIR")
        
        if [[ "$NEW_FRAMES" == "N/A" || -z "$NEW_FRAMES" ]]; then
            NEW_DURATION=$($FFPROBE -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$TEMP_IN_DIR")
            DURATION_DIFF=$(echo "$NEW_DURATION - $ORIG_DURATION" | bc -l | tr -d '-')
            IS_DURATION_VALID=$(echo "$DURATION_DIFF < 3.0" | bc -l)
        else
            FRAME_DIFF=$((ORIG_FRAMES - NEW_FRAMES))
            FRAME_DIFF=${FRAME_DIFF#-} 
            if [ "$FRAME_DIFF" -lt 5 ]; then IS_DURATION_VALID=1; else IS_DURATION_VALID=0; fi
        fi

        OLD_SIZE=$(stat -c%s "$INPUT"); NEW_SIZE=$(stat -c%s "$TEMP_IN_DIR")
        THRESHOLD=$(echo "$OLD_SIZE * (1-$space_svg)" | bc -l)
        IS_SIZE_VALID=$(echo "$NEW_SIZE < $THRESHOLD" | bc -l)
        HAS_V_TRACK=$($MEDIAINFO --Inform="Video;%Duration%" "$TEMP_IN_DIR")

        SAVINGS=$(echo "scale=2; 100 - ($NEW_SIZE * 100 / $OLD_SIZE)" | bc -l)
        OLD_SIZE_MB=$((OLD_SIZE / 1048576)); NEW_SIZE_MB=$((NEW_SIZE / 1048576))

        if [[ "$IS_DURATION_VALID" -eq 1 && "$IS_SIZE_VALID" -eq 1 && -n "$HAS_V_TRACK" ]]; then
            write_log INFO "Safety checks passed. Savings: ${SAVINGS}% (${OLD_SIZE_MB}MB -> ${NEW_SIZE_MB}MB). Replacing original."
            FINAL_OUTPUT="$2/${BASENAME%.*}-OPT.mkv"
            
            # Atomic move from Input Staging to Monitored Output
            mv "$TEMP_IN_DIR" "$FINAL_OUTPUT"
            rm "$INPUT"
        else
            [[ "$IS_DURATION_VALID" -eq 0 ]] && write_log WARN "Duration/Frame mismatch (Orig: $ORIG_FRAMES vs New: $NEW_FRAMES)"
            [[ "$IS_SIZE_VALID" -eq 0 ]] && write_log WARN "Insufficient savings (${SAVINGS}%). Keeping original."
            [[ -z "$HAS_V_TRACK" ]] && write_log ERROR "No video track detected."
            
            rm -f "$TEMP_IN_DIR"
            mv "$INPUT" "$2/${BASENAME%.*}-OPT.${EXT}"
            write_log INFO "Marked original as -OPT."
        fi
    fi
}

# Recursive Process
process_directory() {
    local input_path="$1"; local output_path="$2"
    if [ ! -d "$output_path" ]; then mkdir -p "$output_path"; fi
    find "$input_path" -type f -name "*." -exec mv {} {}mkv \;
    for item in "$input_path"/*; do
        if [ ! -e "$item" ]; then continue; fi
        if [ -d "$item" ]; then process_directory "$item" "$output_path/$(basename "$item")"
        elif [ -f "$item" ]; then
            filename=$(basename "$item"); ext="${filename##*.}"
            if [[ ! ",$ALLOWED_EXT," =~ ",$ext," ]] || [[ "$filename" == *"-OPT"* ]]; then continue; fi
            transcode "$item" "$output_path"
        fi
    done
}

# MAIN BODY
check_helper_bin
write_log INFO "Beginning Execution"

# Cleanup stale hidden temp files in both trees
write_log INFO "Cleaning up stale temporary files..."
find "$TV_INPUT_DIR" -name ".*.av1.tmp" -type f -delete 2>/dev/null
find "$TV_OUTPUT_DIR" -name ".*.av1.tmp" -type f -delete 2>/dev/null

process_directory "$TV_INPUT_DIR" "$TV_OUTPUT_DIR"

# Cleanup Dirs
if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then find "$TV_INPUT_DIR" -mindepth 1 -type d -empty -delete; fi
find "$TV_OUTPUT_DIR" -mindepth 1 -type d -empty -delete

# Notify Sonarr
if [[ $SONARR -eq 1 ]]; then
    curl -s http://$PLEX_IP:8989/api/v3/command -X POST -d "{\"name\": \"DownloadedEpisodesScan\", \"path\": \"$TV_OUTPUT_DIR\"}" -H "X-Api-Key: $SONARR_API_KEY" -H "Content-Type: application/json"
fi

# Plex Update
if [[ $NOPLEX -eq 0 && -x "$SCRIPT_DIR/Plex-update" ]]; then "$SCRIPT_DIR/Plex-update"; fi