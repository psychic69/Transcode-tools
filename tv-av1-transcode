#!/bin/bash

# --- Global Binaries and Paths ---
JQ=/usr/bin/jq
FFMPEG="/usr/lib/jellyfin-ffmpeg/ffmpeg" 
FFPROBE="/usr/lib/jellyfin-ffmpeg/ffprobe"
MEDIAINFO="/usr/bin/mediainfo"
DEVICE="/dev/dri/renderD128"
LOG_DIR="/media/rips/logs"
ALLOWED_EXT="mp4,mkv"

export LIBVA_MESSAGING_LEVEL=1

# --- Global Log Definition ---
SHORT_DATE=$(date "+%m-%d-%y")
CURRENT_LOG="$LOG_DIR/logfile-${SHORT_DATE}-PID${$}"

TOTAL_SAVED_BYTES=0
TOTAL_FILES_PROCESSED=0
TOTAL_ORIGINAL_SIZE=0

# ************************************************
function cleanup_on_exit {
    if [[ -n "$TEMP_IN_DIR" && -f "$TEMP_IN_DIR" ]]; then
        echo "[WARN] Script interrupted. Removing incomplete file: $TEMP_IN_DIR"
        rm -f "$TEMP_IN_DIR"
    fi
    exit 1
}
trap cleanup_on_exit SIGINT SIGTERM

if [[ $# -eq 0 ]]; then
    echo "Usage: $0 [-debug] [-noplex] [-sonarr] [-keep] <input_dir> [output_dir]"
    exit 1
fi

# Parse command line arguments
DEBUG=0; NOPLEX=0; SONARR=0; KEEP=0
for arg in "$@"; do
    if [[ "$arg" == "-debug" ]]; then DEBUG=1; fi
    if [[ "$arg" == "-noplex" ]]; then NOPLEX=1; fi
    if [[ "$arg" == "-sonarr" ]]; then SONARR=1; fi
    if [[ "$arg" == "-keep" ]]; then KEEP=1; fi
done

# Set directory parameters
TV_INPUT_DIR=""; TV_OUTPUT_DIR=""; arg_count=0
for arg in "$@"; do
    if [[ "$arg" != "-debug" && "$arg" != "-noplex" && "$arg" != "-sonarr" && "$arg" != "-keep" ]]; then
        ((arg_count++))
        if [[ $arg_count -eq 1 ]]; then TV_INPUT_DIR="$arg"; elif [[ $arg_count -eq 2 ]]; then TV_OUTPUT_DIR="$arg"; fi
    fi
done
TV_OUTPUT_DIR=${TV_OUTPUT_DIR:-$TV_INPUT_DIR}

# Load parameter.ini
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARAM_FILE="$SCRIPT_DIR/parameter.ini"
if [[ ! -f "$PARAM_FILE" ]]; then echo "ERROR: parameter.ini not found"; exit 1; fi
source "$PARAM_FILE"

# ************************************************
function write_log {
    local short_time=$(date "+%H:%M")
    if [[ -z "$ROTATION_DONE" ]]; then
        local days=${LOG_RETENTION_DAYS:-7}
        find "$LOG_DIR" -name "logfile-*" -type f -mtime +"$days" -delete 2>/dev/null
        ROTATION_DONE=1
    fi
    touch "${CURRENT_LOG}"
    case $1 in
        WARN | INFO | ERROR )
            echo "[$1] (${SHORT_DATE}, ${short_time}) [PID:$$]: $2" >> "${CURRENT_LOG}"
            [[ -t 1 ]] && echo "[$1] $2"
            if [ "$1" = "ERROR" ]; then exit 1; fi ;;
    esac
}

function transcode {
    local gq=28; local bf=7; local space_svg=0.2; local min_size_mb=100
    INPUT="$1"; BASENAME=$(basename "$INPUT")
    INPUT_DIR=$(dirname "$INPUT")
    OUTPUT_MIRROR_DIR="$2"

    TEMP_IN_DIR="$INPUT_DIR/.${BASENAME%.*}.av1.tmp"
    rm -f "$TEMP_IN_DIR"*

    METADATA=$($FFPROBE -v error -show_entries stream=codec_name,codec_type,nb_frames,r_frame_rate,pix_fmt,channels -show_entries format=duration -of json "$INPUT")
    V_CODEC=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .codec_name' | head -n1)
    SRC_FPS=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .r_frame_rate' | head -n1)
    
    VIDEO_OPTS=("-vf" "vpp_qsv=format=p010,fps=fps=$SRC_FPS" "-c:v" "av1_qsv" "-preset" "3" "-global_quality:v" "$gq" "-extbrc" "1" "-b_strategy" "1" "-bf" "$bf" "-low_power" "0" "-async_depth" "4")

    # Audio Logic (Copy AAC, Transcode others to Opus)
    A_CODEC=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .codec_name' | head -n1)
    A_CHANNELS=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .channels' | head -n1)
    A_CODEC_LOWER=$(echo "$A_CODEC" | tr '[:upper:]' '[:lower:]')
    if [[ "$A_CODEC_LOWER" == *"aac"* ]]; then AUDIO_OPTS=("-c:a" "copy"); else
        case $A_CHANNELS in 2) A_BIT="128k"; MAPPING="" ;; 6) A_BIT="256k"; MAPPING="-mapping_family 1" ;; *) A_BIT="128k"; MAPPING="" ;; esac
        AUDIO_OPTS=("-af" "aresample=async=1" "-c:a" "libopus" "-b:a" "$A_BIT" "-vbr" "on" $MAPPING)
    fi

    write_log INFO "------------------------------------------"
    write_log INFO "Processing: $BASENAME"
    
    local log_lvl="error"
    [[ $DEBUG -eq 1 ]] && log_lvl="info"

    FFMPEG_CMD=("$FFMPEG" "-hide_banner" "-loglevel" "$log_lvl" "-y" "-hwaccel" "qsv" "-qsv_device" "$DEVICE" "-hwaccel_output_format" "qsv")
    "${FFMPEG_CMD[@]}" -i "$INPUT" -map 0:v:0 -map 0:a? -map 0:s? -c:s copy -map_metadata -1 "${VIDEO_OPTS[@]}" "${AUDIO_OPTS[@]}" -f matroska "$TEMP_IN_DIR" >> "${CURRENT_LOG}" 2>&1

    if [ $? -eq 0 ] && [[ -f "$TEMP_IN_DIR" ]]; then
        # 1. Verification Check: Does the new file have a video stream?
        HAS_VIDEO=$($FFPROBE -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$TEMP_IN_DIR")
        
        OLD_SIZE=$(stat -c%s "$INPUT")
        NEW_SIZE=$(stat -c%s "$TEMP_IN_DIR")
        NEW_SIZE_MB=$(echo "scale=2; $NEW_SIZE / 1048576" | bc -l)
        SAVINGS=$(echo "scale=2; 100 - ($NEW_SIZE * 100 / $OLD_SIZE)" | bc -l)

        if [[ -n "$HAS_VIDEO" ]] && [[ $(echo "$NEW_SIZE_MB > $min_size_mb" | bc -l) -eq 1 ]]; then
            # Checks passed
            write_log INFO "Checks Passed. Size: ${NEW_SIZE_MB}MB. Savings: ${SAVINGS}%."
            
            TOTAL_SAVED_BYTES=$((TOTAL_SAVED_BYTES + (OLD_SIZE - NEW_SIZE)))
            ((TOTAL_FILES_PROCESSED++))

            if [[ $KEEP -eq 1 ]]; then
                mkdir -p "$OUTPUT_MIRROR_DIR"
                mv "$TEMP_IN_DIR" "$OUTPUT_MIRROR_DIR/${BASENAME%.*}-OPT.mkv"
            else
                mv "$TEMP_IN_DIR" "$INPUT_DIR/${BASENAME%.*}-OPT.mkv" && rm "$INPUT"
                if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
                    mkdir -p "$OUTPUT_MIRROR_DIR"
                    mv "$INPUT_DIR/${BASENAME%.*}-OPT.mkv" "$OUTPUT_MIRROR_DIR/${BASENAME%.*}-OPT.mkv"
                fi
            fi
        else
            # FAILURE LOGIC
            write_log WARN "FAILURE on $BASENAME. (Size: ${NEW_SIZE_MB}MB, VideoStream: ${HAS_VIDEO:-NONE})"
            write_log WARN "Prepending ERROR- to original file."
            
            # Rename original to ERROR-[filename]
            mv "$INPUT" "$INPUT_DIR/ERROR-$BASENAME"
            rm -f "$TEMP_IN_DIR"
        fi
    else
        # FFmpeg itself failed
        write_log WARN "FFmpeg exited with error code on $BASENAME. Renaming original to ERROR-."
        mv "$INPUT" "$INPUT_DIR/ERROR-$BASENAME"
        rm -f "$TEMP_IN_DIR"
    fi
}

# Recursion logic remains same...
process_directory() {
    local input_path="$1"
    local output_path="$2"
    if [ ! -d "$output_path" ]; then mkdir -p "$output_path"; fi
    
    for item in "$input_path"/*; do
        if [ ! -e "$item" ]; then continue; fi
        if [ -d "$item" ]; then 
            process_directory "$item" "$output_path/$(basename "$item")"
        elif [ -f "$item" ]; then
            filename=$(basename "$item"); ext="${filename##*.}"
            # Ignore files already marked as Error or Optimized
            if [[ "$filename" == "ERROR-"* ]] || [[ "$filename" == *"-OPT"* ]]; then continue; fi
            if [[ ! ",$ALLOWED_EXT," =~ ",$ext," ]]; then continue; fi
            transcode "$item" "$output_path"
        fi
    done
}

# --- Main execution remains same ---
check_helper_bin
write_log INFO "Start. Input: $TV_INPUT_DIR | Output: $TV_OUTPUT_DIR"
find "$TV_INPUT_DIR" -name ".*.av1.tmp" -type f -delete 2>/dev/null
process_directory "$TV_INPUT_DIR" "$TV_OUTPUT_DIR"
# (Rest of post-processing logic)