#!/bin/bash

JQ=/usr/bin/jq
FFMPEG="/usr/lib/jellyfin-ffmpeg/ffmpeg" 
FFPROBE="/usr/lib/jellyfin-ffmpeg/ffprobe"
MEDIAINFO=/usr/bin/mediainfo
DEVICE="/dev/dri/renderD128"
LOG_DIR="/media/rips/logs"
ALLOWED_EXT="mp4,mkv"

# Data to inject into the script
#  $1 - The {base_dir}
#  $2 - only using this if using middleman between sonarr input and output dir


TV_INPUT_DIR=$1
TV_OUTPUT_DIR=${2:-$1}

# ************************************************
function write_log {
# This function will write log information to a file
# $1 Error Type  (WARN, INFO, ERROR)
# $2 Error Message

local short_date
local short_time
local log_file


short_date=$(date "+%m-%d-%y")
short_time=$(date "+%H:%M")
log_file="$LOG_DIR/logfile-$short_date"

touch "$log_file"

#did it create

if [ ! -e "$log_file" ]; then
  echo "Critial error, cannot create logfile: $log_file"
  exit 1
fi

# OK assume I can append to the logfile :)

case $1 in
 WARN | INFO | ERROR )

echo "[$1] ($short_date, $short_time): $2" >> "$log_file"

if [ "$1" = "ERROR" ]; then
  exit 1
fi

;;
* )
# Seomthing is wrong with incoming, term

echo "[ERROR] Could not get incoming log flag WARN, INFO, or ERROR:  Sent [$1]?" >> "$log_file"
exit 1
;;

esac
}


# ************************************************
function check_helper_bin {

# This function checks to see if the helper bin used in the program are available

if [ ! -x "$JQ" ] ; then 
 write_log ERROR "Cannot find jq program"
fi

if [ ! -x "$MEDIAINFO" ] ; then 
 write_log ERROR "Cannot find mediainfo program"
fi

if [ ! -x "$FFPROBE" ] ; then 
 write_log ERROR "Cannot find jellyfin ffprobe program"
fi

if [ ! -x "$FFMPEG" ] ; then 
 write_log ERROR "Cannot find jellyfin ffmpeg program"
fi

#Can I write to the _DIR or create it  ##UPDATE will do in same dir

if [ ! -w "$TV_INPUT_DIR" ]; then
 write_log ERROR "Cannot write to TV input dir: $TV_INPUT_DIR or it doesn't exist"

fi

if [ ! -w "$TV_OUTPUT_DIR" ]; then
 write_log ERROR "Cannot write to TV output dir: $TV_OUTPUT_DIR or it doesn't exist"

fi

if [ ! -e "$DEVICE" ]; then
 write_log ERROR "GPU device $DEVICE does not exist. Hardware acceleration will fail."

fi

}



# ************************************************
function transcode {

# $1 - file to transcode (source media file under consideration)
# $2 - where to write it to TV_OUTPUT_DIR

#ffmpeg base settings, sloooo
local gq=28
local look_depth=60
local bf=7
local space_svg=0.3   #This means need a min 30% reduction to accept this file"


#First things first.  Need to check what type of audio we are dealing with
echo "File name to check for transcode $1"

# INPUT is the entire file name with directory tree, EXT gets the incoming extension of the source file
INPUT="$1"
BASENAME=$(basename "$INPUT")
EXT="${BASENAME##*.}"

##Will write the temporary file to the TV_OUTPUT_DIR
OUTPUT="$2/${BASENAME%.*}.av1.tmp.mkv"

####Beginning of deep dive

# --- 2. Identify Metadata ---
V_CODEC=$($FFPROBE -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$INPUT")
A_CODEC=$($FFPROBE -v error -select_streams a:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$INPUT" | head -n1)
A_CHANNELS=$($FFPROBE -v error -select_streams a:0 -show_entries stream=channels -of default=noprint_wrappers=1:nokey=1 "$INPUT" | head -n1)
ORIG_DURATION=$($FFPROBE -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$INPUT")

# --- 3. Skip Logic (AV1 + AAC) ---
if [[ "$V_CODEC" == "av1" && "$A_CODEC" == "aac" ]]; then
    write_log "INFO" "Skipping $BASENAME: Already AV1 and AAC."
    return
fi

# --- 4. Video Strategy ---
if [[ "$V_CODEC" == "av1" ]]; then
    write_log "INFO" "Video is AV1. Setting Video to Passthrough."
    VIDEO_OPTS="-c:v copy"
else
    PIX_FMT=$($FFPROBE -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "$INPUT")
    [[ "$PIX_FMT" == *"10le"* ]] && VF_CHAIN="format=qsv" || VF_CHAIN="format=qsv,scale_qsv=format=p010"
    
    VIDEO_OPTS="-vf $VF_CHAIN -c:v av1_qsv -preset 7 -global_quality $gq -look_ahead_depth $look_depth -extbrc 1 -b_strategy 1 -bf $bf -low_power 0"
    write_log "INFO" "Video is $V_CODEC ($PIX_FMT). Initializing Intel QSV AV1 10-bit Encode."
fi

# --- 5. Audio Strategy ---
if [[ "$A_CODEC" == "aac" ]]; then
    write_log "INFO" "Audio is AAC. Setting Audio to Passthrough."
    AUDIO_OPTS="-c:a copy"
else
    case $A_CHANNELS in
        2)  AUDIO_OPTS="-c:a libopus -b:a 128k -vbr on -ac 2" ;;
        6)  AUDIO_OPTS="-c:a libopus -b:a 192k -vbr on -ac 6 -af channelmap=FL-FL|FR-FR|FC-FC|LFE-LFE|SL-BL|SR-BR" ;;
        8)  AUDIO_OPTS="-c:a libopus -b:a 256k -vbr on -ac 8 -af channelmap=FL-FL|FR-FR|FC-FC|LFE-LFE|SL-BL|SR-BR|BL-SL|BR-SR" ;;
        *)  AUDIO_OPTS="-c:a libopus -b:a 128k -vbr on" ;; 
    esac
    write_log "INFO" "Audio is $A_CODEC ($A_CHANNELS ch). Transcoding to Opus with Channel Mapping fix."
fi

# --- 6. Execution ---
write_log "INFO" "Executing FFmpeg command..."
if [[ "$V_CODEC" == "av1" ]]; then
    $FFMPEG -i "$INPUT" -map 0:v:0 -map 0:a? -map 0:s? -map_metadata 0 $VIDEO_OPTS $AUDIO_OPTS -c:s mov_text -movflags +faststart "$OUTPUT" >> "$LOG_DIR/logfile-$(date "+%m-%d-%y")" 2>&1
else
    $FFMPEG -hwaccel qsv -qsv_device "$DEVICE" -hwaccel_output_format qsv \
      -i "$INPUT" -map 0:v:0 -map 0:a? -map 0:s? -map_metadata 0 $VIDEO_OPTS $AUDIO_OPTS -c:s mov_text -movflags +faststart "$OUTPUT" >> "$LOG_DIR/logfile-$(date "+%m-%d-%y")" 2>&1
fi

if [ $? -ne 0 ]; then
    write_log "ERROR" "FFmpeg process crashed for $BASENAME."
    rm -f "$OUTPUT"
    return
fi

# --- 7. Safety Checks & Logging ---
if [[ -f "$OUTPUT" ]]; then
    NEW_DURATION=$($FFPROBE -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$OUTPUT")
    DURATION_DIFF=$(echo "$NEW_DURATION - $ORIG_DURATION" | bc -l | tr -d '-')
    IS_DURATION_VALID=$(echo "$DURATION_DIFF < 2.0" | bc -l)

    OLD_SIZE=$(stat -c%s "$INPUT")
    NEW_SIZE=$(stat -c%s "$OUTPUT")
    THRESHOLD=$(echo "$OLD_SIZE * (1-$space_svg)" | bc -l)
    IS_SIZE_VALID=$(echo "$NEW_SIZE < $THRESHOLD" | bc -l)
    HAS_V_TRACK=$($MEDIAINFO --Inform="Video;%Duration%" "$OUTPUT")

    if [[ "$IS_DURATION_VALID" -eq 1 && "$IS_SIZE_VALID" -eq 1 && -n "$HAS_V_TRACK" ]]; then
        SAVINGS=$(echo "100 - ($NEW_SIZE / $OLD_SIZE * 100)" | bc -l)
        write_log "INFO" "Safety checks passed. Savings: $(printf '%.2f' $SAVINGS)%. Replacing original."
        FINAL_OUTPUT="$2/${BASENAME%.*}-OPT.mkv"
        mv "$OUTPUT" "$FINAL_OUTPUT"
        [[ "$INPUT" != *.mkv ]] && rm "$INPUT"
    else
        [ "$IS_DURATION_VALID" -eq 0 ] && write_log "WARN" "Duration mismatch: Orig $ORIG_DURATION vs New $NEW_DURATION"
        [ "$IS_SIZE_VALID" -eq 0 ] && write_log "INFO" "Target 30% savings not met. Keeping original."
        [ -z "$HAS_V_TRACK" ] && write_log "ERROR" "Muxing error: No video track found in output."
        rm -f "$OUTPUT"
        # Mark original file as already processed (with -OPT flag) so it won't be retried
        MARKED_FILE="$2/${BASENAME%.*}-OPT.${EXT}"
        mv "$INPUT" "$MARKED_FILE"
        write_log "INFO" "Marked $BASENAME as -OPT (no compression benefit or error)."
    fi
else
    write_log "ERROR" "Output file missing after FFmpeg execution."
fi

}


# Main Script Body ________________________________________________

check_helper_bin
write_log INFO "Beginning of Script Execution, loading modules"

#Incoming encode files to pass to transcode block

# Check and create output dir once before processing files if needed
if [ ! -w "$TV_OUTPUT_DIR" ]; then
  mkdir -p "$TV_OUTPUT_DIR"
  if [ ! -w "$TV_OUTPUT_DIR" ]; then
    write_log ERROR "Could not create $TV_OUTPUT_DIR"
  fi
fi

# Loop through the media files in the directory sent into the script 

for SOURCE_FILE in "$TV_INPUT_DIR"/*
 do
   # Skip directories and non-matching extensions
   if [ ! -f "$SOURCE_FILE" ]; then
     continue
   fi

   # Check if file extension matches ALLOWED_EXT
   filename=$(basename "$SOURCE_FILE")
   ext="${filename##*.}"

   if [[ ! ",$ALLOWED_EXT," =~ ",$ext," ]]; then
     continue
   fi

   # Skip files that have already been optimized
   if [[ "$filename" == *"-OPT"* ]]; then
     continue
   fi

   transcode "$SOURCE_FILE" "$TV_OUTPUT_DIR"

 done

