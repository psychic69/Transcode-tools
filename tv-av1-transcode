#!/bin/bash

# --- Global Binaries and Paths ---
JQ=/usr/bin/jq
FFMPEG="/usr/lib/jellyfin-ffmpeg/ffmpeg" 
FFPROBE="/usr/lib/jellyfin-ffmpeg/ffprobe"
MEDIAINFO="/usr/bin/mediainfo"
DEVICE="/dev/dri/renderD128"
LOG_DIR="/media/rips/logs"
ALLOWED_EXT="mp4,mkv"

export LIBVA_MESSAGING_LEVEL=1

# --- Global Log Definition ---
SHORT_DATE=$(date "+%m-%d-%y")
CURRENT_LOG="$LOG_DIR/logfile-${SHORT_DATE}-PID${$}"

TOTAL_SAVED_BYTES=0
TOTAL_FILES_PROCESSED=0

# ************************************************
function check_helper_bin {
    for bin in "$FFMPEG" "$FFPROBE" "$JQ"; do
        if [[ ! -x "$bin" ]]; then echo "ERROR: $bin not found"; exit 1; fi
    done
}

function cleanup_on_exit {
    if [[ -n "$TEMP_IN_DIR" && -f "$TEMP_IN_DIR" ]]; then
        echo "[WARN] Script interrupted. Removing incomplete file: $TEMP_IN_DIR"
        rm -f "$TEMP_IN_DIR"
    fi
    exit 1
}
trap cleanup_on_exit SIGINT SIGTERM

if [[ $# -eq 0 ]]; then
    echo "Usage: $0 [-debug] [-noplex] [-sonarr] [-keep] [-test] [-gc <val>] [-file] <input> [output]"
    exit 1
fi

# Parse command line arguments
DEBUG=0; NOPLEX=0; SONARR=0; KEEP=0; TEST_MODE=0; OVERRIDE_GQ=""; SINGLE_FILE_MODE=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -debug) DEBUG=1; shift ;;
        -noplex) NOPLEX=1; shift ;;
        -sonarr) SONARR=1; shift ;;
        -keep) KEEP=1; shift ;;
        -test) TEST_MODE=1; shift ;;
        -file) SINGLE_FILE_MODE=1; shift ;;
        -gc) OVERRIDE_GQ="$2"; shift 2 ;;
        -*) shift ;; 
        *) break ;;  
    esac
done

# Resolve Paths
TV_INPUT_DIR=$(realpath "$1")
if [[ -n "$2" ]]; then
    TV_OUTPUT_DIR=$(realpath "$2")
else
    if [[ $SINGLE_FILE_MODE -eq 1 ]]; then
        TV_OUTPUT_DIR=$(dirname "$TV_INPUT_DIR")
    else
        TV_OUTPUT_DIR="$TV_INPUT_DIR"
    fi
fi

# Load parameter.ini
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARAM_FILE="$SCRIPT_DIR/parameter.ini"
if [[ ! -f "$PARAM_FILE" ]]; then echo "ERROR: parameter.ini not found"; exit 1; fi
source "$PARAM_FILE"

# ************************************************
function write_log {
    local short_time=$(date "+%H:%M")
    if [[ -z "$ROTATION_DONE" ]]; then
        local days=${LOG_RETENTION_DAYS:-7}
        find "$LOG_DIR" -name "logfile-*" -type f -mtime +"$days" -delete 2>/dev/null
        ROTATION_DONE=1
    fi
    touch "${CURRENT_LOG}"
    case $1 in
        WARN | INFO | ERROR )
            echo "[$1] (${SHORT_DATE}, ${short_time}) [PID:$$]: $2" >> "${CURRENT_LOG}"
            [[ -t 1 ]] && echo "[$1] $2"
            if [ "$1" = "ERROR" ]; then exit 1; fi ;;
    esac
}

function transcode {
    local gq=28
    [[ -n "$OVERRIDE_GQ" ]] && gq="$OVERRIDE_GQ"
    
    local bf=7; local min_size_mb=100
    INPUT="$1"; BASENAME=$(basename "$INPUT")
    INPUT_DIR=$(dirname "$INPUT")
    OUTPUT_MIRROR_DIR="$2"

    # --- Migration/Adoption Logic ---
    if [[ "$BASENAME" == *"-OPT.mkv" ]]; then
        if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
            write_log INFO "Migrating existing optimized file: $BASENAME"
            mkdir -p "$OUTPUT_MIRROR_DIR"
            mv "$INPUT" "$OUTPUT_MIRROR_DIR/$BASENAME"
            ((TOTAL_FILES_PROCESSED++))
            return
        else
            return
        fi
    fi

    TEMP_IN_DIR="$INPUT_DIR/.${BASENAME%.*}.av1.tmp"
    rm -f "$TEMP_IN_DIR"*

    # Detailed Metadata Gathering
    METADATA=$($FFPROBE -v error -show_entries stream=codec_name,codec_type,nb_frames,r_frame_rate,pix_fmt,channels -show_entries format=duration -of json "$INPUT")
    V_CODEC=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .codec_name' | head -n1)
    SRC_FPS=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .r_frame_rate' | head -n1)
    A_CODEC=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .codec_name' | head -n1)
    A_CHANNELS=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .channels' | head -n1)
    A_CODEC_LOWER=$(echo "$A_CODEC" | tr '[:upper:]' '[:lower:]')

    if [[ "$A_CODEC_LOWER" == *"aac"* ]]; then AUDIO_OPTS=("-c:a" "copy"); else
        case $A_CHANNELS in 2) A_BIT="128k"; MAPPING="" ;; 6) A_BIT="256k"; MAPPING="-mapping_family 1" ;; *) A_BIT="128k"; MAPPING="" ;; esac
        AUDIO_OPTS=("-af" "aresample=async=1" "-c:a" "libopus" "-b:a" "$A_BIT" "-vbr" "on" $MAPPING)
    fi

    COMMON_V_OPTS=("-c:v" "av1_qsv" "-preset" "3" "-global_quality:v" "$gq" "-extbrc" "1" "-b_strategy" "1" "-bf" "$bf" "-g" "600" "-low_power" "0" "-async_depth" "12")

    write_log INFO "=========================================="
    write_log INFO "Processing: $BASENAME"
    write_log INFO "=========================================="
    write_log INFO "Video: $V_CODEC | FPS: $SRC_FPS | Audio: $A_CODEC ($A_CHANNELS ch) | GQ: $gq"
    
    local log_lvl="error"
    [[ $DEBUG -eq 1 ]] && log_lvl="info"

    FFMPEG_CMD=("$FFMPEG" "-hide_banner" "-loglevel" "$log_lvl" "-y" "-init_hw_device" "vaapi=va:$DEVICE" "-init_hw_device" "qsv=hw@va" "-hwaccel" "vaapi" "-hwaccel_device" "va" "-hwaccel_output_format" "vaapi")
    FILTER_OPTS=("-vf" "hwmap=derive_device=qsv,vpp_qsv=format=p010,fps=fps=$SRC_FPS")

    TEST_OPTS=()
    [[ $TEST_MODE -eq 1 ]] && TEST_OPTS=("-t" "300")

    write_log INFO "Executing FFmpeg command (Hybrid Path)..."
    start_time=$(date +%s)
    "${FFMPEG_CMD[@]}" -i "$INPUT" "${TEST_OPTS[@]}" -map 0:v:0 -map 0:a? -map 0:s? -c:s copy -map_metadata -1 "${FILTER_OPTS[@]}" "${COMMON_V_OPTS[@]}" "${AUDIO_OPTS[@]}" -f matroska "$TEMP_IN_DIR" >> "${CURRENT_LOG}" 2>&1
    exit_code=$?
    end_time=$(date +%s)
    duration=$((end_time - start_time))

    if [ $exit_code -eq 0 ] && [[ -f "$TEMP_IN_DIR" ]]; then
        HAS_VIDEO=$($FFPROBE -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$TEMP_IN_DIR")
        OLD_SIZE=$(stat -c%s "$INPUT")
        NEW_SIZE=$(stat -c%s "$TEMP_IN_DIR")
        OLD_SIZE_MB=$(echo "scale=2; $OLD_SIZE / 1048576" | bc -l)
        NEW_SIZE_MB=$(echo "scale=2; $NEW_SIZE / 1048576" | bc -l)
        SAVINGS=$(echo "scale=2; 100 - ($NEW_SIZE * 100 / $OLD_SIZE)" | bc -l)

        if [[ -n "$HAS_VIDEO" ]] && { [[ $TEST_MODE -eq 1 ]] || [[ $(echo "$NEW_SIZE_MB > $min_size_mb" | bc -l) -eq 1 ]]; }; then
            write_log INFO "Safety checks passed. Savings: ${SAVINGS}% (${OLD_SIZE_MB}MB -> ${NEW_SIZE_MB}MB)."
            TOTAL_SAVED_BYTES=$((TOTAL_SAVED_BYTES + (OLD_SIZE - NEW_SIZE)))
            ((TOTAL_FILES_PROCESSED++))

            if [[ $KEEP -eq 1 ]]; then
                mkdir -p "$OUTPUT_MIRROR_DIR"; mv "$TEMP_IN_DIR" "$OUTPUT_MIRROR_DIR/${BASENAME%.*}-OPT.mkv"
            else
                mv "$TEMP_IN_DIR" "$INPUT_DIR/${BASENAME%.*}-OPT.mkv" && rm "$INPUT"
                if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
                    mkdir -p "$OUTPUT_MIRROR_DIR"; mv "$INPUT_DIR/${BASENAME%.*}-OPT.mkv" "$OUTPUT_MIRROR_DIR/${BASENAME%.*}-OPT.mkv"
                fi
            fi
        else
            write_log WARN "FAILURE on $BASENAME. Renaming to ERROR-."
            mv "$INPUT" "$INPUT_DIR/ERROR-$BASENAME"
            rm -f "$TEMP_IN_DIR"
        fi
    else
        write_log WARN "FFmpeg failed on $BASENAME."
        rm -f "$TEMP_IN_DIR"
    fi
}

process_directory() {
    local input_path="$1"; local output_path="$2"
    if [ ! -d "$output_path" ]; then mkdir -p "$output_path"; fi
    for item in "$input_path"/*; do
        if [ ! -e "$item" ]; then continue; fi
        if [ -d "$item" ]; then process_directory "$item" "$output_path/$(basename "$item")"
        elif [ -f "$item" ]; then
            filename=$(basename "$item"); ext="${filename##*.}"
            if [[ "$filename" == "ERROR-"* ]]; then continue; fi
            if [[ ! ",$ALLOWED_EXT," =~ ",$ext," ]]; then continue; fi
            transcode "$item" "$output_path"
        fi
    done
}

# --- Execution ---
check_helper_bin
write_log INFO "Start. Input: $TV_INPUT_DIR | Output: $TV_OUTPUT_DIR"

# Clean up temp files before starting
TEMP_FIND_DIR=$( [[ $SINGLE_FILE_MODE -eq 1 ]] && echo "$(dirname "$TV_INPUT_DIR")" || echo "$TV_INPUT_DIR" )
find "$TEMP_FIND_DIR" -name ".*.av1.tmp" -type f -delete 2>/dev/null

if [[ $SINGLE_FILE_MODE -eq 1 ]]; then
    if [[ -f "$TV_INPUT_DIR" ]]; then
        transcode "$TV_INPUT_DIR" "$TV_OUTPUT_DIR"
    else
        write_log ERROR "-file flag used but input is not a file."
    fi
else
    process_directory "$TV_INPUT_DIR" "$TV_OUTPUT_DIR"
fi

# --- RECURSIVE EMPTY DIRECTORY CLEANUP ---
if [[ $SINGLE_FILE_MODE -eq 0 ]]; then
    echo "[INFO] Cleaning up empty directory trees..."
    
    # Clean input staging area (bottom-up)
    find "$TV_INPUT_DIR" -depth -type d -not -path "$TV_INPUT_DIR" -exec rmdir {} + 2>/dev/null
    
    # Clean output area if different from input
    if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then
        find "$TV_OUTPUT_DIR" -depth -type d -not -path "$TV_OUTPUT_DIR" -exec rmdir {} + 2>/dev/null
    fi
fi

SAVED_GB=$(echo "scale=2; $TOTAL_SAVED_BYTES / 1073741824" | bc)
write_log INFO "------------------------------------------"
write_log INFO "Finished. Files Processed: $TOTAL_FILES_PROCESSED. Total Saved: ${SAVED_GB}GB."