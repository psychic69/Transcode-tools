#!/bin/bash

# --- Global Binaries and Paths ---
JQ=/usr/bin/jq
FFMPEG="/usr/lib/jellyfin-ffmpeg/ffmpeg" 
FFPROBE="/usr/lib/jellyfin-ffmpeg/ffprobe"
MEDIAINFO="/usr/bin/mediainfo"
DEVICE="/dev/dri/renderD128"
LOG_DIR="/media/rips/logs"
ALLOWED_EXT="mp4,mkv"

# --- Global Log Definition (Your Recommendation) ---
SHORT_DATE=$(date "+%m-%d-%y")
CURRENT_LOG="$LOG_DIR/logfile-${SHORT_DATE}-PID${$}"

# --- Counters for Final Summary ---
TOTAL_SAVED_BYTES=0
TOTAL_FILES_PROCESSED=0
TOTAL_ORIGINAL_SIZE=0

# ************************************************
# Function to clean up on exit/interrupt (Trap)
# ************************************************
function cleanup_on_exit {
    if [[ -n "$TEMP_IN_DIR" && -f "$TEMP_IN_DIR" ]]; then
        echo "[WARN] Script interrupted. Removing incomplete file: $TEMP_IN_DIR"
        rm -f "$TEMP_IN_DIR"
    fi
    exit 1
}

trap cleanup_on_exit SIGINT SIGTERM

if [[ $# -eq 0 ]]; then
    echo "Usage: $0 [-debug] [-noplex] [-sonarr] <input_dir> [output_dir]"
    exit 1
fi

# Parse command line arguments
DEBUG=0; NOPLEX=0; SONARR=0
for arg in "$@"; do
    if [[ "$arg" == "-debug" ]]; then DEBUG=1; fi
    if [[ "$arg" == "-noplex" ]]; then NOPLEX=1; fi
    if [[ "$arg" == "-sonarr" ]]; then SONARR=1; fi
done

# Set directory parameters
TV_INPUT_DIR=""; TV_OUTPUT_DIR=""; arg_count=0
for arg in "$@"; do
    if [[ "$arg" != "-debug" && "$arg" != "-noplex" && "$arg" != "-sonarr" ]]; then
        ((arg_count++))
        if [[ $arg_count -eq 1 ]]; then TV_INPUT_DIR="$arg"; elif [[ $arg_count -eq 2 ]]; then TV_OUTPUT_DIR="$arg"; fi
    fi
done
TV_OUTPUT_DIR=${TV_OUTPUT_DIR:-$TV_INPUT_DIR}

# Redirect logic referencing the Global Log variable
if [[ $DEBUG -eq 0 ]]; then 
    FFMPEG_REDIRECT="> /dev/null 2>&1"
else 
    FFMPEG_REDIRECT=">> ${CURRENT_LOG} 2>&1"
fi

# Load parameter.ini
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARAM_FILE="$SCRIPT_DIR/parameter.ini"
if [[ ! -f "$PARAM_FILE" ]]; then echo "ERROR: parameter.ini not found"; exit 1; fi
source "$PARAM_FILE"

# ************************************************
function write_log {
    local short_time=$(date "+%H:%M")
    
    # --- Dynamic Log Rotation ---
    if [[ -z "$ROTATION_DONE" ]]; then
        local days=${LOG_RETENTION_DAYS:-7}
        find "$LOG_DIR" -name "logfile-*" -type f -mtime +"$days" -delete 2>/dev/null
        ROTATION_DONE=1
    fi

    touch "${CURRENT_LOG}"
    case $1 in
        WARN | INFO | ERROR )
            echo "[$1] (${SHORT_DATE}, ${short_time}) [PID:$$]: $2" >> "${CURRENT_LOG}"
            [[ -t 1 ]] && echo "[$1] $2"
            if [ "$1" = "ERROR" ]; then exit 1; fi ;;
    esac
}

# ************************************************
function check_helper_bin {
    if [ ! -x "$JQ" ] || [ ! -x "$MEDIAINFO" ] || [ ! -x "$FFPROBE" ] || [ ! -x "$FFMPEG" ]; then write_log ERROR "Bins missing"; fi
    if [ ! -w "$TV_INPUT_DIR" ] || [ ! -w "$TV_OUTPUT_DIR" ]; then write_log ERROR "Perms issue"; fi
}

# ************************************************
# ************************************************
function transcode {
    local gq=28; local bf=7; local space_svg=0.2
    
    INPUT="$1"; BASENAME=$(basename "$INPUT"); EXT="${BASENAME##*.}"
    IN_DIR=$(dirname "$INPUT")
    
    write_log INFO "=========================================="
    write_log INFO "Processing: $BASENAME"
    write_log INFO "=========================================="

    TEMP_IN_DIR="$2/.${BASENAME%.*}.av1.tmp"
    rm -f "$TEMP_IN_DIR"*

    # --- 1. Metadata Detection ---
    METADATA=$($FFPROBE -v error -show_entries stream=codec_name,codec_type,nb_frames,r_frame_rate,pix_fmt,channels -show_entries format=duration -of json "$INPUT")

    V_CODEC=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .codec_name' | head -n1)
    SRC_FPS=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .r_frame_rate' | head -n1)
    ORIG_FRAMES=$(echo "$METADATA" | $JQ -r '.streams[] | select(.codec_type=="video") | .nb_frames' | head -n1)
    A_CODEC=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .codec_name' | head -n1)
    A_CHANNELS=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="audio")][0] | .channels' | head -n1)
    S_CODEC=$(echo "$METADATA" | $JQ -r '[.streams[] | select(.codec_type=="subtitle")][0] | .codec_name' | head -n1)
    ORIG_DURATION=$(echo "$METADATA" | $JQ -r '.format.duration' | head -n1)

    [[ "$ORIG_FRAMES" == "null" ]] && ORIG_FRAMES=0

    # --- 2. Subtitle Strategy (Passthrough only) ---
    SUBTITLE_OPTS=("-map" "0:s?" "-c:s" "copy")

    # --- 3. Video Strategy (Fixed Hardware Handoff) ---
    if [[ "$V_CODEC" == "av1" ]]; then 
        VIDEO_OPTS=("-c:v" "copy")
    else
        # This specific chain fixes the "Impossible to convert" error:
        # vpp_qsv=format=p010 ensures the hardware scales 8-bit to 10-bit correctly.
        VIDEO_OPTS=(
            "-vf" "vpp_qsv=format=p010,fps=fps=$SRC_FPS" 
            "-c:v" "av1_qsv" 
            "-preset" "7" 
            "-global_quality:v" "$gq" 
            "-extbrc" "1" 
            "-b_strategy" "1" 
            "-bf" "$bf" 
            "-low_power" "0"
        )
    fi

    # --- 4. Audio Strategy ---
    A_CODEC_LOWER=$(echo "$A_CODEC" | tr '[:upper:]' '[:lower:]')
    if [[ "$A_CODEC_LOWER" == *"aac"* ]]; then
        AUDIO_OPTS=("-c:a" "copy")
    else
        case $A_CHANNELS in 
            2) A_BIT="128k"; MAPPING="" ;; 
            6) A_BIT="256k"; MAPPING="-mapping_family 1" ;; 
            *) A_BIT="128k"; MAPPING="" ;; 
        esac
        AUDIO_OPTS=("-af" "aresample=async=1" "-c:a" "libopus" "-b:a" "$A_BIT" "-vbr" "on" $MAPPING)
    fi
    
    # --- 5. Execution (Corrected HW Initialization) ---
    write_log INFO "Executing FFmpeg command..."
    
    FFMPEG_CMD=("$FFMPEG" "-hide_banner" "-loglevel" "error" "-y")
    
    # We must set the init_devices and filter_hw_device to avoid the "Function not implemented" error
    "${FFMPEG_CMD[@]}" -hwaccel qsv -qsv_device "$DEVICE" -hwaccel_output_format qsv \
        -i "$INPUT" \
        -map 0:v:0 -map 0:a? "${SUBTITLE_OPTS[@]}" \
        -map_metadata 0 "${VIDEO_OPTS[@]}" "${AUDIO_OPTS[@]}" \
        -f matroska "$TEMP_IN_DIR" >> "${CURRENT_LOG}" 2>&1
    
    FFMPEG_EXIT_CODE=$?
    
    if [ $FFMPEG_EXIT_CODE -ne 0 ]; then
        write_log ERROR "FFmpeg crashed (Code: $FFMPEG_EXIT_CODE). Check ${CURRENT_LOG}"
        rm -f "$TEMP_IN_DIR"
        return
    fi

    # --- 6. Safety Checks ---
    if [[ -f "$TEMP_IN_DIR" ]]; then
        OLD_SIZE=$(stat -c%s "$INPUT"); NEW_SIZE=$(stat -c%s "$TEMP_IN_DIR")
        SAVINGS=$(echo "scale=2; 100 - ($NEW_SIZE * 100 / $OLD_SIZE)" | bc -l)

        # Standard check: if it created a file and didn't crash, we'll take it
        write_log INFO "Success: ${SAVINGS}% savings. Replacing original."
        TOTAL_SAVED_BYTES=$((TOTAL_SAVED_BYTES + (OLD_SIZE - NEW_SIZE)))
        TOTAL_ORIGINAL_SIZE=$((TOTAL_ORIGINAL_SIZE + OLD_SIZE))
        ((TOTAL_FILES_PROCESSED++))
        mv "$TEMP_IN_DIR" "$2/${BASENAME%.*}-OPT.mkv" && rm "$INPUT"
    fi
}

####################################################
process_directory() {
    local input_path="$1"; local output_path="$2"
    if [ ! -d "$output_path" ]; then mkdir -p "$output_path"; fi
    
    for item in "$input_path"/*; do
        if [ ! -e "$item" ]; then continue; fi
        if [ -d "$item" ]; then 
            process_directory "$item" "$output_path/$(basename "$item")"
        elif [ -f "$item" ]; then
            filename=$(basename "$item"); ext="${filename##*.}"
            if [[ "$filename" == *"-OPT"* ]]; then
                if [[ "$input_path" != "$output_path" ]]; then
                    write_log INFO "Moving pre-optimized file: $filename"
                    mv "$item" "$output_path/$filename"
                    ((TOTAL_FILES_PROCESSED++))
                fi
                continue
            fi
            if [[ ! ",$ALLOWED_EXT," =~ ",$ext," ]]; then continue; fi
            transcode "$item" "$output_path"
        fi
    done
}

# --- MAIN BODY ---
check_helper_bin
write_log INFO "Beginning Execution. Log: ${CURRENT_LOG}"

find "$TV_INPUT_DIR" -name ".*.av1.tmp" -type f -delete 2>/dev/null
process_directory "$TV_INPUT_DIR" "$TV_OUTPUT_DIR"

if [ "$TOTAL_FILES_PROCESSED" -gt 0 ]; then
    if [[ "$TV_INPUT_DIR" != "$TV_OUTPUT_DIR" ]]; then find "$TV_INPUT_DIR" -mindepth 1 -type d -empty -delete; fi

    if [[ $SONARR -eq 1 ]]; then
        TARGET_IP=${SONARR_IP:-$PLEX_IP}
        write_log INFO "Notifying Sonarr at $TARGET_IP..."
        curl -s "http://${TARGET_IP}:8989/api/v3/command" -X POST -d "{\"name\": \"DownloadedEpisodesScan\", \"path\": \"$TV_OUTPUT_DIR\"}" -H "X-Api-Key: $SONARR_API_KEY" -H "Content-Type: application/json" > /dev/null
    fi

    if [[ $NOPLEX -eq 0 && -x "$SCRIPT_DIR/Plex-update" ]]; then 
        write_log INFO "Running Plex-update..."
        "$SCRIPT_DIR/Plex-update"
    fi
fi

# --- FINAL SUMMARY ---
if [ "$TOTAL_FILES_PROCESSED" -gt 0 ]; then
    TOTAL_SAVED_GB=$(echo "scale=2; $TOTAL_SAVED_BYTES / 1073741824" | bc -l)
    TOTAL_ORIG_GB=$(echo "scale=2; $TOTAL_ORIGINAL_SIZE / 1073741824" | bc -l)
    write_log INFO "******************************************"
    write_log INFO "    FINAL SESSION SUMMARY"
    write_log INFO "******************************************"
    write_log INFO "Files Re-encoded/Moved: $TOTAL_FILES_PROCESSED"
    write_log INFO "Total Storage Reclaimed: ${TOTAL_SAVED_GB} GB (from ${TOTAL_ORIG_GB} GB)"
    write_log INFO "Log file: ${CURRENT_LOG}"
    write_log INFO "******************************************"
else
    write_log INFO "No files were optimized or moved during this run."
fi